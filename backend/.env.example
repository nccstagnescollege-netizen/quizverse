# ==============================================================================
# QUIZVERSE BACKEND ENVIRONMENT BLUEPRINT (FASTAPI)
# ==============================================================================

# Server Runtime
PROJECT_NAME="QUIZVERSE API"
VERSION="1.0.0"
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://quizverse.vercel.app

# Supabase PostgreSQL Connection
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Note: Use transaction pooler (port 6543) for serverless environments
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase API Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Optional Future Redis Cache
REDIS_URL=redis://localhost:6379/0
