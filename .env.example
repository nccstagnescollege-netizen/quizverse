# ==============================================================================
# QUIZVERSE MASTER ENVIRONMENT BLUEPRINT
# ==============================================================================
# Copy frontend/.env.example to frontend/.env.local
# Copy backend/.env.example to backend/.env

# --- FRONTEND CONFIGURATION (NEXT.JS APP ROUTER) ---
# Target: Vercel Free Tier / Local Port 3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# --- BACKEND CONFIGURATION (FASTAPI) ---
# Target: Render Free Tier / Local Port 8000
PROJECT_NAME="QUIZVERSE API"
VERSION="1.0.0"
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://quizverse.vercel.app

# Supabase PostgreSQL Pooler URI (Confidential - Backend only)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase Server-Side Privileged Credentials (Confidential - Backend only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Storage Bucket Names
SUPABASE_STORAGE_BUCKET_ATTACHMENTS=exam-attachments
SUPABASE_STORAGE_BUCKET_MODELS=3d-models

# Optional Future Redis Cache
REDIS_URL=redis://localhost:6379/0
