# Server Environment
PORT=8787
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173

# Supabase Credentials (Server-side privileged access only)
# Never share or expose the service role key to frontend clients
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres
