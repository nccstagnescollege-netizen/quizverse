{
  "name": "quizverse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "QUIZVERSE - Advanced 3D Interactive Online Quiz & Examination Platform",
  "scripts": {
    "dev:frontend": "pnpm --dir frontend dev",
    "dev:backend": "backend\\venv\\Scripts\\python.exe -m uvicorn backend.app.main:app --reload --port 8000",
    "build:frontend": "pnpm --dir frontend build",
    "typecheck:frontend": "pnpm --dir frontend typecheck",
    "test:backend": "backend\\venv\\Scripts\\pytest.exe -c backend/pytest.ini backend/tests",
    "test": "backend\\venv\\Scripts\\pytest.exe -c backend/pytest.ini backend/tests",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^2.1.5"
  },
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.0.0"
  }
}
